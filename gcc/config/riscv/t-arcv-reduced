empty =
space = $(empty) $(empty)

MULTILIB_OPTIONS =
MULTILIB_DIRNAMES =
MULTILIB_REQUIRED =
MULTILIB_REUSE =

# Reduced march variants: one per mtune
arcv_march_variants  = rv32imac_zcb_zba_zbb_zbs_zfinx_zdinx_zicsr
arcv_march_variants += rv32imafd_zca_zcb_zba_zbb_zbs
arcv_march_variants += rv64imafdc_zcb_zba_zbb_zbs

MULTILIB_OPTIONS    += $(subst $(space),/,$(patsubst %,march=%,$(arcv_march_variants)))
MULTILIB_DIRNAMES   += $(arcv_march_variants)

MULTILIB_OPTIONS    += mabi=ilp32/mabi=ilp32d/mabi=lp64d
MULTILIB_DIRNAMES   +=      ilp32      ilp32d      lp64d

MULTILIB_OPTIONS    += mtune=arc-v-rmx-500-series/mtune=arc-v-rmx-700-series/mtune=arc-v-rhx-100-series/mtune=arc-v-rpx-100-series
MULTILIB_DIRNAMES   +=       rmx500                     rmx700                     rhx100                     rpx100

MULTILIB_OPTIONS    += mcmodel=medany
MULTILIB_DIRNAMES   +=         medany

# One configuration per mtune target:

# RMX-100 (default tune)
MULTILIB_REQUIRED   += march=rv32imac_zcb_zba_zbb_zbs_zfinx_zdinx_zicsr/mabi=ilp32

# RMX-500
MULTILIB_REQUIRED   += march=rv32imafd_zca_zcb_zba_zbb_zbs/mabi=ilp32d/mtune=arc-v-rmx-500-series

# RMX-700 shares the RMX-500 library
MULTILIB_REUSE      += march.rv32imafd_zca_zcb_zba_zbb_zbs/mabi.ilp32d/mtune.arc-v-rmx-500-series=march.rv32imafd_zca_zcb_zba_zbb_zbs/mabi.ilp32d/mtune.arc-v-rmx-700-series

# RHX-100
MULTILIB_REQUIRED   += march=rv32imafd_zca_zcb_zba_zbb_zbs/mabi=ilp32d/mtune=arc-v-rhx-100-series

# RPX-100
MULTILIB_REQUIRED   += march=rv64imafdc_zcb_zba_zbb_zbs/mabi=lp64d/mtune=arc-v-rpx-100-series/mcmodel=medany
