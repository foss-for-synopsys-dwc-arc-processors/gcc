#!/usr/bin/env python3
"""Generate the hierarchical allowlist from testsuite .sum results.

Companion to `testsuite-filter`. Given the testsuite results for every CI
target, rebuild the allowlist so that a failure shared by *all* targets is
recorded once in `common.log` and every other failure lives in its target's
leaf file. This is exactly the split `testsuite-filter` reads back
(`common.log` plus the most-specific `<base_arch>[.<abi>].log`), so an allowlist
generated from a set of .sum files makes the filter report zero surviving
results on those same files.

Usage:

    gen-allowlist --allowlist-dir .github/allowlist \\
        --target rv64gc:lp64d:rocket                results/rv64 \\
        --target rv32gc:ilp32d:rocket               results/rv32 \\
        --target rv32gc:ilp32d:arc-v-rhx-100-series results/rv32-rhx \\
        --target arc-em                             results/arc-em \\
        --target arc-hs38_linux                     results/arc-hs38_linux

Each `--target` takes a SPEC (`arch[:abi[:tune]]`) and a PATH that is either a
.sum/.log file or a directory searched recursively for *.sum files. Repeat
`--target` with the same SPEC to add more inputs for that target.

Results are split across three levels of generality: `common.log` (shared by
every target), a tune-agnostic `<base_arch>[.<abi>].log` (shared by all mtunes
of that arch/abi), and a per-mtune `<base_arch>[.<abi>].<tune>.log`. A target
whose SPEC omits the tune writes straight to the tune-agnostic file, so it
applies to all mtunes.

`common.log` is the intersection across *all* supplied targets, so you must
pass every target in a single invocation for it to be correct: passing a subset
would wrongly promote that subset's shared failures into `common.log`. Only the
files this run computes (`common.log` and one leaf per supplied target) are
overwritten; other allowlist files are left untouched.
"""

from __future__ import print_function

import argparse
import os
import re
import sys
from collections import OrderedDict

# Same set of "unexpected" statuses the filter treats as regressions.
UNEXPECTED_RE = re.compile(r"^(FAIL|XPASS|UNRESOLVED|ERROR)\b")

HEADER = (
    "# Generated by .github/scripts/gen-allowlist from testsuite .sum results.\n"
    "# Format: <STATUS>: <testpath> (matched by testsuite-filter).\n"
)


def base_arch(arch):
    """Base arch as testsuite-filter's Arch sees it (rv32/rv64/rv128 or whole)."""
    m = re.match(r"rv(32|64|128)", arch)
    return m.group(0) if m else arch


def stem_name(arch, abi):
    """Tune-agnostic allowlist stem testsuite-filter selects for (arch, abi)."""
    b = base_arch(arch)
    return "%s.%s" % (b, abi) if abi else b


def iter_sum_files(path):
    """Yield .sum files under a directory, or the path itself if it is a file."""
    if os.path.isdir(path):
        for root, _, files in os.walk(path):
            for fn in sorted(files):
                if fn.endswith(".sum"):
                    yield os.path.join(root, fn)
    elif os.path.exists(path):
        yield path
    else:
        print("warning: no such path: %s" % path, file=sys.stderr)


def collect(paths):
    """Return (entries, scanned) where entries is the set of normalised
    `STATUS: testpath` lines drawn from every unexpected result in the inputs."""
    entries = set()
    scanned = 0
    for path in paths:
        for f in iter_sum_files(path):
            scanned += 1
            with open(f, errors="replace") as fh:
                for line in fh:
                    if UNEXPECTED_RE.match(line):
                        toks = line.split()
                        if len(toks) >= 2:
                            # Collapse all variations of a test to STATUS: path,
                            # the prefix testsuite-filter matches against.
                            entries.add(toks[0] + " " + toks[1])
    return entries, scanned


def write_log(path, entries):
    with open(path, "w") as f:
        f.write(HEADER)
        for e in sorted(entries):
            f.write(e + "\n")


def parse_spec(spec):
    parts = spec.split(":")
    arch = parts[0]
    abi = parts[1] if len(parts) > 1 and parts[1] else ""
    tune = parts[2] if len(parts) > 2 and parts[2] else ""
    return arch, abi, tune


def main():
    p = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--allowlist-dir", required=True,
                   help="base allowlist directory (contains <tool>/)")
    p.add_argument("--tool", default="gcc",
                   help="allowlist subdirectory / toolset (default: gcc)")
    p.add_argument("--target", nargs=2, action="append", default=[],
                   metavar=("SPEC", "PATH"), dest="targets",
                   help="arch[:abi] and a .sum file or directory of results; "
                        "repeatable")
    args = p.parse_args()

    if not args.targets:
        p.error("at least one --target is required")

    out_dir = os.path.join(args.allowlist_dir, args.tool)
    if not os.path.isdir(out_dir):
        p.error("allowlist dir does not exist: %s" % out_dir)

    # Group inputs by tune-agnostic stem, then by mtune within each stem.
    # A (stem, tune) cell may receive several PATHs.
    groups = OrderedDict()
    for spec, path in args.targets:
        arch, abi, tune = parse_spec(spec)
        stem = stem_name(arch, abi)
        cell = groups.setdefault(stem, OrderedDict())
        cell.setdefault(tune, {"label": spec, "paths": []})
        cell[tune]["paths"].append(path)

    # Collect each (stem, tune) target's normalised result set.
    collected = OrderedDict()   # stem -> [(tune, entries), ...]
    all_sets = []
    for stem, cell in groups.items():
        for tune, info in cell.items():
            entries, scanned = collect(info["paths"])
            if scanned == 0:
                p.error("no .sum files found for target %s under: %s"
                        % (info["label"], ", ".join(info["paths"])))
            collected.setdefault(stem, []).append((tune, entries))
            all_sets.append(entries)
            disp = "%s.%s.log" % (stem, tune) if tune else "%s.log" % stem
            print("%-26s %-34s %5d results from %d .sum file(s)"
                  % (info["label"], disp, len(entries), scanned))

    # common.log = failures present in *every* target.
    common = set.intersection(*all_sets) if all_sets else set()
    write_log(os.path.join(out_dir, "common.log"), common)
    print("\ncommon.log                         %5d shared result(s)"
          % len(common))

    # Within each stem, a tune-agnostic <stem>.log holds failures shared by all
    # of that stem's tunes (minus common); each tune's remainder goes to
    # <stem>.<tune>.log. A lone untuned target writes straight to <stem>.log.
    for stem, members in collected.items():
        tuned = [(t, e) for t, e in members if t]
        untuned = [e for t, e in members if not t]

        if len(members) == 1 and tuned:
            tune, entries = tuned[0]
            name = "%s.%s.log" % (stem, tune)
            remainder = entries - common
            write_log(os.path.join(out_dir, name), remainder)
            print("%-34s %5d unique result(s)" % (name, len(remainder)))
            continue

        if tuned:
            shared = set.intersection(*[e for _, e in tuned]) - common
        else:
            shared = set()
        for e in untuned:               # untuned targets apply to all mtunes
            shared |= e - common

        stem_log = "%s.log" % stem
        write_log(os.path.join(out_dir, stem_log), shared)
        print("%-34s %5d shared result(s)" % (stem_log, len(shared)))
        for tune, entries in tuned:
            name = "%s.%s.log" % (stem, tune)
            remainder = entries - common - shared
            write_log(os.path.join(out_dir, name), remainder)
            print("%-34s %5d unique result(s)" % (name, len(remainder)))


if __name__ == "__main__":
    main()
